# Server Configuration
PORT=5000
HOST=0.0.0.0

# Device Security
# Microcontrollers (ESP32/ESP8266) must provide this token in the 'X-Device-Token' HTTP header
DEVICE_SECRET_TOKEN=iot-device-secure-token-2026

# Operational Modes
# Set to 'true' to simulate realistic sensor telemetry when physical hardware is not connected
DEMO_MODE=true
DEMO_INTERVAL_MS=2500

# Database
DATABASE_PATH=./data/iot_sensors.db

# Heartbeat & Health
# Time in milliseconds before a sensor or device is flagged as offline if no new readings arrive
SENSOR_TIMEOUT_MS=30000
